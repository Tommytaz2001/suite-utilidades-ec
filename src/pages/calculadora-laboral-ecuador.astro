<!-- LÓGICA JAVASCRIPT CLIENT-SIDE              -->
<!-- ========================================== -->
<script>
  // Formateador moneda
  const fmt = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const round2 = (n: number) => Math.round((n + Number.EPSILON) * 100) / 100;

  // Constantes de Ley Ecuador
  const TASA_IESS_PERSONAL = 0.0945;
  const TASA_IESS_PATRONAL = 0.1115;
  const TASA_FONDOS_RESERVA = 0.0833;

  // -------------------------------------------------------------
  // CONTROL DE PESTAÑAS (TABS)
  // -------------------------------------------------------------
  const tabButtons = document.querySelectorAll('.toggle-group .toggle-btn[data-tab]');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');
      if (!targetId) return;

      tabButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      tabPanes.forEach(pane => {
        const el = pane as HTMLElement;
        if (el.id === targetId) {
          el.style.display = 'block';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // -------------------------------------------------------------
  // MÓDULO 1: ROL MENSUAL
  // -------------------------------------------------------------
  const inpRolSueldo = document.getElementById('rol-sueldo') as HTMLInputElement;
  const inpRolAdic   = document.getElementById('rol-adicionales') as HTMLInputElement;
  const chkRol13     = document.getElementById('rol-check-13') as HTMLInputElement;
  const chkRol14     = document.getElementById('rol-check-14') as HTMLInputElement;
  const chkRolFondos = document.getElementById('rol-check-fondos') as HTMLInputElement;
  const btnCalcRol   = document.getElementById('btn-calc-rol') as HTMLButtonElement;

  const statRolNeto     = document.getElementById('stat-rol-neto')!;
  const statRolIess     = document.getElementById('stat-rol-iess')!;
  const detRolBruto     = document.getElementById('det-rol-bruto')!;
  const detRolIess      = document.getElementById('det-rol-iess')!;
  const rowDet13        = document.getElementById('row-det-13') as HTMLElement;
  const detRol13        = document.getElementById('det-rol-13')!;
  const rowDet14        = document.getElementById('row-det-14') as HTMLElement;
  const detRol14        = document.getElementById('det-rol-14')!;
  const rowDetFondos    = document.getElementById('row-det-fondos') as HTMLElement;
  const detRolFondos    = document.getElementById('det-rol-fondos')!;
  const detRolTotal     = document.getElementById('det-rol-total')!;
  const statRolPatronal = document.getElementById('stat-rol-patronal')!;
  const statRolCostoEmp = document.getElementById('stat-rol-costo-empresa')!;

  function calcularRol() {
    const sueldoBase = parseFloat(inpRolSueldo.value) || 0;
    const adicionales = parseFloat(inpRolAdic.value) || 0;
    const sbu = 460.0;

    const ingresoGravable = sueldoBase + adicionales;
    const aportePersonal = round2(ingresoGravable * TASA_IESS_PERSONAL);
    const aportePatronal = round2(ingresoGravable * TASA_IESS_PATRONAL);

    let val13 = 0;
    if (chkRol13.checked) {
      val13 = round2(ingresoGravable / 12);
      rowDet13.style.display = 'flex';
      detRol13.textContent = fmt(val13);
    } else {
      rowDet13.style.display = 'none';
    }

    let val14 = 0;
    if (chkRol14.checked) {
      val14 = round2(sbu / 12);
      rowDet14.style.display = 'flex';
      detRol14.textContent = fmt(val14);
    } else {
      rowDet14.style.display = 'none';
    }

    let valFondos = 0;
    if (chkRolFondos.checked) {
      valFondos = round2(ingresoGravable * TASA_FONDOS_RESERVA);
      rowDetFondos.style.display = 'flex';
      detRolFondos.textContent = fmt(valFondos);
    } else {
      rowDetFondos.style.display = 'none';
    }

    const sueldoNeto = round2(ingresoGravable - aportePersonal + val13 + val14 + valFondos);

    // Costo total de provisiones empresa:
    const prov13 = round2(ingresoGravable / 12);
    const prov14 = round2(sbu / 12);
    const provFondos = round2(ingresoGravable * TASA_FONDOS_RESERVA);
    const provVacaciones = round2(ingresoGravable / 24);
    const costoEmpresa = round2(ingresoGravable + aportePatronal + prov13 + prov14 + provFondos + provVacaciones);

    // Renderizar
    statRolNeto.textContent = fmt(sueldoNeto);
    statRolIess.textContent = fmt(aportePersonal);
    detRolBruto.textContent = fmt(ingresoGravable);
    detRolIess.textContent = `-${fmt(aportePersonal)}`;
    detRolTotal.textContent = fmt(sueldoNeto);
    statRolPatronal.textContent = fmt(aportePatronal);
    statRolCostoEmp.textContent = fmt(costoEmpresa);
  }

  btnCalcRol.addEventListener('click', calcularRol);
  [inpRolSueldo, inpRolAdic, chkRol13, chkRol14, chkRolFondos].forEach(el => {
    el.addEventListener('input', calcularRol);
    el.addEventListener('change', calcularRol);
  });

  // -------------------------------------------------------------
  // MÓDULO 2: DÉCIMOS Y FONDOS ACUMULADOS
  // -------------------------------------------------------------
  const inpDecSueldo = document.getElementById('dec-sueldo') as HTMLInputElement;
  const selDecMeses  = document.getElementById('dec-meses') as HTMLSelectElement;
  const selDecRegion = document.getElementById('dec-region') as HTMLSelectElement;
  const inpDecSbu    = document.getElementById('dec-sbu') as HTMLInputElement;
  const btnCalcDec   = document.getElementById('btn-calc-decimos') as HTMLButtonElement;

  const statDec13    = document.getElementById('stat-dec-13')!;
  const statDec14    = document.getElementById('stat-dec-14')!;
  const statDecFondos= document.getElementById('stat-dec-fondos')!;
  const dec14Info    = document.getElementById('dec-14-info')!;

  function calcularDecimos() {
    const sueldo = parseFloat(inpDecSueldo.value) || 0;
    const meses = parseInt(selDecMeses.value) || 12;
    const sbu = parseFloat(inpDecSbu.value) || 460.0;
    const region = selDecRegion.value;

    // 13°: Ganado en el período / 12
    const total13 = round2((sueldo * meses) / 12);

    // 14°: Proporcional al tiempo laborado sobre 1 SBU
    const total14 = round2((sbu / 12) * meses);

    // Fondos de reserva
    const totalFondos = round2(sueldo * meses * TASA_FONDOS_RESERVA);

    statDec13.textContent = fmt(total13);
    statDec14.textContent = fmt(total14);
    statDecFondos.textContent = fmt(totalFondos);

    if (region === 'costa') {
      dec14Info.innerHTML = `📅 <strong>Régimen Costa e Insular:</strong> Pago máximo hasta el <strong>15 de Marzo</strong>.<br />Período computable: 1 Mar a último día de Feb (${meses} meses calculados).`;
    } else {
      dec14Info.innerHTML = `📅 <strong>Régimen Sierra y Amazonía:</strong> Pago máximo hasta el <strong>15 de Agosto</strong>.<br />Período computable: 1 Ago a 31 Jul (${meses} meses calculados).`;
    }
  }

  btnCalcDec.addEventListener('click', calcularDecimos);
  [inpDecSueldo, selDecMeses, selDecRegion, inpDecSbu].forEach(el => {
    el.addEventListener('input', calcularDecimos);
    el.addEventListener('change', calcularDecimos);
  });

  // -------------------------------------------------------------
  // MÓDULO 3: SIMULADOR DE LIQUIDACIÓN / FINIQUITO
  // -------------------------------------------------------------
  const selLiqMotivo        = document.getElementById('liq-motivo') as HTMLSelectElement;
  const inpLiqSueldo        = document.getElementById('liq-sueldo') as HTMLInputElement;
  const inpLiqAnios         = document.getElementById('liq-anios') as HTMLInputElement;
  const inpLiqMeses         = document.getElementById('liq-meses') as HTMLInputElement;
  const inpLiqDiasMes       = document.getElementById('liq-dias-mes') as HTMLInputElement;
  const inpLiqVac           = document.getElementById('liq-dias-vacaciones') as HTMLInputElement;
  const btnSugerirVac       = document.getElementById('btn-sugerir-vac') as HTMLButtonElement;
  const chkLiqDesahucioFrac = document.getElementById('liq-desahucio-fraccion') as HTMLInputElement;
  const selLiqRegion        = document.getElementById('liq-region') as HTMLSelectElement;
  const chkLiqAcum          = document.getElementById('liq-acumula-decimos') as HTMLInputElement;
  const liqDecimosMesesWrap = document.getElementById('liq-decimos-meses-wrap') as HTMLElement;
  const inpLiqMeses13       = document.getElementById('liq-meses-13') as HTMLInputElement;
  const inpLiqMeses14       = document.getElementById('liq-meses-14') as HTMLInputElement;
  const btnCalcLiq          = document.getElementById('btn-calc-liq') as HTMLButtonElement;
  const btnExportCsv        = document.getElementById('btn-exportar-liq-csv') as HTMLButtonElement;
  const btnImprimir         = document.getElementById('btn-imprimir-liq') as HTMLButtonElement;

  const statLiqTotal        = document.getElementById('stat-liq-total')!;
  const statLiqSub          = document.getElementById('stat-liq-sub')!;
  const rowLiqDespido       = document.getElementById('row-liq-despido') as HTMLElement;
  const detLiqDespido       = document.getElementById('det-liq-despido')!;
  const rowLiqDesahucio     = document.getElementById('row-liq-desahucio') as HTMLElement;
  const detLiqDesahucio     = document.getElementById('det-liq-desahucio')!;
  const detLiqDias          = document.getElementById('det-liq-dias')!;
  const detLiqVac           = document.getElementById('det-liq-vacaciones')!;
  const rowLiqDec13         = document.getElementById('row-liq-dec13') as HTMLElement;
  const detLiqDec13         = document.getElementById('det-liq-dec13')!;
  const rowLiqDec14         = document.getElementById('row-liq-dec14') as HTMLElement;
  const detLiqDec14         = document.getElementById('det-liq-dec14')!;
  const detLiqIess          = document.getElementById('det-liq-iess')!;
  const detLiqGranTot       = document.getElementById('det-liq-gran-total')!;

  // Elementos del Acta Proforma Imprimible
  const printFecha     = document.getElementById('print-fecha')!;
  const printMotivo    = document.getElementById('print-motivo')!;
  const printSueldo    = document.getElementById('print-sueldo')!;
  const printTiempo    = document.getElementById('print-tiempo')!;
  const printTablaBody = document.getElementById('print-tabla-body')!;
  const printTotal     = document.getElementById('print-total')!;

  // Sugerir vacaciones según antigüedad (Art. 69 Código del Trabajo)
  btnSugerirVac?.addEventListener('click', () => {
    const anios = parseInt(inpLiqAnios.value) || 0;
    const dias = anios <= 5 ? 15 : Math.min(15 + (anios - 5), 30);
    inpLiqVac.value = String(dias);
    calcularLiquidacion();
  });

  // Mostrar / ocultar meses de décimos
  chkLiqAcum?.addEventListener('change', () => {
    liqDecimosMesesWrap.style.display = chkLiqAcum.checked ? 'grid' : 'none';
  });

  interface LiquidacionResultado {
    motivoTexto: string;
    sueldo: number;
    anios: number;
    meses: number;
    diasMes: number;
    diasVac: number;
    despido: number;
    desahucio: number;
    diasTrabajados: number;
    vacaciones: number;
    decimo13: number;
    decimo14: number;
    iessRetencion: number;
    total: number;
    aniosComputables: number;
    tiempoDesahucio: number;
    tiempoComp13: number;
    tiempoComp14: number;
    valorDiaVacacion: number;
  }

  let ultimaLiquidacion: LiquidacionResultado | null = null;

  function calcularLiquidacion(): LiquidacionResultado {
    const motivo = selLiqMotivo.value;
    const sueldo = parseFloat(inpLiqSueldo.value) || 0;
    const anios = parseInt(inpLiqAnios.value) || 0;
    const meses = parseInt(inpLiqMeses.value) || 0;
    const diasMes = parseInt(inpLiqDiasMes.value) || 0;
    const diasVac = parseInt(inpLiqVac.value) || 0;
    const acumula = chkLiqAcum.checked;
    const fraccionDesahucio = chkLiqDesahucioFrac.checked;
    const sbu = 460.0;

    let motivoTexto = 'Despido Intempestivo (Art. 188 + 185)';
    if (motivo === 'desahucio') motivoTexto = 'Renuncia Voluntaria / Desahucio (Art. 185)';
    if (motivo === 'acuerdo') motivoTexto = 'Acuerdo de las Partes / Vencimiento de Contrato';
    if (motivo === 'prueba') motivoTexto = 'Despido en Período de Prueba (≤ 90 días)';

    let despido = 0;
    let aniosComputables = 0;

    // 1. Indemnización por Despido Intempestivo (Art. 188)
    if (motivo === 'despido') {
      // Fracción de año se considera año completo
      aniosComputables = meses > 0 ? anios + 1 : Math.max(anios, 1);

      if (aniosComputables <= 3) {
        despido = round2(sueldo * 3);
      } else {
        const factor = Math.min(aniosComputables, 25);
        despido = round2(sueldo * factor);
      }
    }

    // 2. Bonificación por Desahucio (Art. 185) - 25% por cada año de servicio
    let desahucio = 0;
    let tiempoDesahucio = 0;
    if (motivo === 'despido' || motivo === 'desahucio') {
      tiempoDesahucio = fraccionDesahucio
        ? anios + (meses / 12) + (diasMes / 360)
        : anios;
      desahucio = round2(sueldo * 0.25 * tiempoDesahucio);
    }

    // 3. Sueldo días trabajados último mes
    const valorDia = sueldo / 30;
    const diasTrabajados = round2(valorDia * Math.min(diasMes, 30));

    // 4. Vacaciones no gozadas (Art. 69: 15 días anuales equivalen a 0.5 sueldo mensual => sueldo / 30 por día)
    const valorDiaVacacion = round2(sueldo / 30);
    const vacaciones = round2((sueldo / 30) * diasVac);

    // 5. Proporcionales de Décimos
    let decimo13 = 0;
    let decimo14 = 0;
    let tiempoComp13 = 0;
    let tiempoComp14 = 0;

    if (acumula) {
      const meses13 = parseFloat(inpLiqMeses13.value) || 0;
      const meses14 = parseFloat(inpLiqMeses14.value) || 0;

      tiempoComp13 = meses13 + (diasMes / 30);
      decimo13 = round2((sueldo * tiempoComp13) / 12);

      tiempoComp14 = meses14 + (diasMes / 30);
      decimo14 = round2((sbu * tiempoComp14) / 12);
    }

    // 6. Retención IESS Personal sobre los días trabajados del mes (9.45%)
    const iessRetencion = round2(diasTrabajados * TASA_IESS_PERSONAL);

    // Total líquido
    const total = round2(despido + desahucio + diasTrabajados + vacaciones + decimo13 + decimo14 - iessRetencion);

    // Actualizar UI
    if (despido > 0) {
      rowLiqDespido.style.display = 'flex';
      detLiqDespido.textContent = fmt(despido);
    } else {
      rowLiqDespido.style.display = 'none';
    }

    if (desahucio > 0) {
      rowLiqDesahucio.style.display = 'flex';
      detLiqDesahucio.textContent = fmt(desahucio);
    } else {
      rowLiqDesahucio.style.display = 'none';
    }

    detLiqDias.textContent = fmt(diasTrabajados);
    detLiqVac.textContent = fmt(vacaciones);

    if (acumula) {
      rowLiqDec13.style.display = 'flex';
      rowLiqDec14.style.display = 'flex';
      detLiqDec13.textContent = fmt(decimo13);
      detLiqDec14.textContent = fmt(decimo14);
    } else {
      rowLiqDec13.style.display = 'none';
      rowLiqDec14.style.display = 'none';
    }

    detLiqIess.textContent = `-${fmt(iessRetencion)}`;
    statLiqTotal.textContent = fmt(total);
    detLiqGranTot.textContent = fmt(total);

    if (motivo === 'despido') {
      statLiqSub.textContent = 'Incluye indemnización legal por despido intempestivo + desahucio + haberes';
    } else if (motivo === 'desahucio') {
      statLiqSub.textContent = 'Renuncia voluntaria: Incluye bonificación 25% por desahucio + haberes pendientes';
    } else {
      statLiqSub.textContent = 'Liquidación de haberes y beneficios proporcionales pendientes de cobro';
    }

    // Actualizar Acta Proforma para Impresión
    const fechaActual = new Date().toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' });
    printFecha.textContent = fechaActual;
    printMotivo.textContent = motivoTexto;
    printSueldo.textContent = fmt(sueldo);
    printTiempo.textContent = `${anios} año(s), ${meses} mes(es) y ${diasMes} día(s)`;
    printTotal.textContent = fmt(total);

    let rowsPrint = '';
    if (despido > 0) {
      rowsPrint += `
        <tr>
          <td><strong>Indemnización Despido Intempestivo (Art. 188)</strong></td>
          <td>${aniosComputables} mes(es) de remuneración (fracción computa como año)</td>
          <td style="text-align:right; font-weight:700;">${fmt(despido)}</td>
        </tr>
      `;
    }
    if (desahucio > 0) {
      rowsPrint += `
        <tr>
          <td><strong>Bonificación por Desahucio (Art. 185)</strong></td>
          <td>25% de última remuneración por ${tiempoDesahucio.toFixed(2)} año(s) computable(s)</td>
          <td style="text-align:right; font-weight:700;">${fmt(desahucio)}</td>
        </tr>
      `;
    }
    rowsPrint += `
      <tr>
        <td><strong>Sueldo Días Trabajados del Mes</strong></td>
        <td>${diasMes} día(s) laborados a razón de ${fmt(valorDia)}/día</td>
        <td style="text-align:right;">${fmt(diasTrabajados)}</td>
      </tr>
      <tr>
        <td><strong>Vacaciones No Gozadas (Art. 69)</strong></td>
        <td>${diasVac} día(s) acumulados a razón de ${fmt(valorDiaVacacion)}/día (sueldo ÷ 30)</td>
        <td style="text-align:right;">${fmt(vacaciones)}</td>
      </tr>
    `;
    if (acumula) {
      rowsPrint += `
        <tr>
          <td><strong>Proporcional Décimo Tercer Sueldo (Navideño)</strong></td>
          <td>${tiempoComp13.toFixed(2)} mes(es) acumulados sobre última remuneración</td>
          <td style="text-align:right;">${fmt(decimo13)}</td>
        </tr>
        <tr>
          <td><strong>Proporcional Décimo Cuarto Sueldo (Escolar)</strong></td>
          <td>${tiempoComp14.toFixed(2)} mes(es) acumulados sobre SBU ($${sbu.toFixed(2)})</td>
          <td style="text-align:right;">${fmt(decimo14)}</td>
        </tr>
      `;
    }
    rowsPrint += `
      <tr style="color:#b91c1c;">
        <td><strong>(-) Retención Aporte Personal IESS (9.45%)</strong></td>
        <td>Deducción legal sobre ingresos ordinarios por días trabajados</td>
        <td style="text-align:right; font-weight:700;">-${fmt(iessRetencion)}</td>
      </tr>
    `;
    printTablaBody.innerHTML = rowsPrint;

    ultimaLiquidacion = {
      motivoTexto,
      sueldo,
      anios,
      meses,
      diasMes,
      diasVac,
      despido,
      desahucio,
      diasTrabajados,
      vacaciones,
      decimo13,
      decimo14,
      iessRetencion,
      total,
      aniosComputables,
      tiempoDesahucio,
      tiempoComp13,
      tiempoComp14,
      valorDiaVacacion
    };

    return ultimaLiquidacion;
  }

  btnCalcLiq?.addEventListener('click', calcularLiquidacion);
  [
    selLiqMotivo,
    inpLiqSueldo,
    inpLiqAnios,
    inpLiqMeses,
    inpLiqDiasMes,
    inpLiqVac,
    chkLiqDesahucioFrac,
    selLiqRegion,
    chkLiqAcum,
    inpLiqMeses13,
    inpLiqMeses14
  ].forEach(el => {
    el?.addEventListener('input', calcularLiquidacion);
    el?.addEventListener('change', calcularLiquidacion);
  });

  // -------------------------------------------------------------
  // EXPORTAR A CSV
  // -------------------------------------------------------------
  btnExportCsv?.addEventListener('click', () => {
    const res = calcularLiquidacion();
    const csvContent = [
      ['Rubro / Concepto', 'Base de Calculo / Detalle', 'Monto (USD)'],
      ['Causa de terminacion', res.motivoTexto, ''],
      ['Ultima remuneracion mensual', `$${res.sueldo.toFixed(2)}`, ''],
      ['Tiempo de servicio', `${res.anios} anios, ${res.meses} meses y ${res.diasMes} dias`, ''],
      ['Indemnizacion Despido Intempestivo (Art. 188)', res.despido > 0 ? `${res.aniosComputables} meses de sueldo` : 'No aplica', `$${res.despido.toFixed(2)}`],
      ['Bonificacion por Desahucio (Art. 185)', `${res.tiempoDesahucio.toFixed(2)} anios al 25%`, `$${res.desahucio.toFixed(2)}`],
      ['Sueldo por dias laborados', `${res.diasMes} dias del mes`, `$${res.diasTrabajados.toFixed(2)}`],
      ['Vacaciones no gozadas (Art. 69)', `${res.diasVac} dias a $${res.valorDiaVacacion.toFixed(2)}/dia (sueldo/30)`, `$${res.vacaciones.toFixed(2)}`],
      ['Decimo Tercero proporcional', `${res.tiempoComp13.toFixed(2)} meses acumulados`, `$${res.decimo13.toFixed(2)}`],
      ['Decimo Cuarto proporcional', `${res.tiempoComp14.toFixed(2)} meses sobre SBU`, `$${res.decimo14.toFixed(2)}`],
      ['Descuento IESS Personal (9.45%)', 'Sobre dias laborados', `-$${res.iessRetencion.toFixed(2)}`],
      ['TOTAL NETO A RECIBIR', 'Acta de Finiquito', `$${res.total.toFixed(2)}`]
    ].map(e => e.map(cell => `"${cell}"`).join(',')).join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `liquidacion-laboral-ecuador-${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // -------------------------------------------------------------
  // IMPRIMIR PROFORMA
  // -------------------------------------------------------------
  btnImprimir?.addEventListener('click', () => {
    calcularLiquidacion();
    window.print();
  });

  // Ejecución inicial por defecto
  calcularRol();
  calcularDecimos();
  calcularLiquidacion();
</script>
