<!-- LÓGICA JAVASCRIPT CLIENT-SIDE -->
<script>
  const round = (n: number) => Math.round(n);
  const round1 = (n: number) => Math.round(n * 10) / 10;
  const fmtNum = (n: number) => n.toLocaleString('en-US');

  // Estado
  let isMetric = true;
  let gender = 'male';
  let numComidas = 4;

  // Presets de macros: [Proteína %, Carbos %, Grasas %]
  const MACRO_PRESETS: Record<string, [number, number, number]> = {
    'equilibrada':   [30, 40, 30],
    'alta-proteina': [35, 35, 30],
    'low-carb':      [35, 20, 45],
    'keto':          [25, 5, 70],
    'custom':        [30, 40, 30]
  };

  // Referencias DOM
  const btnMetric     = document.getElementById('btn-unit-metric') as HTMLButtonElement;
  const btnImperial   = document.getElementById('btn-unit-imperial') as HTMLButtonElement;
  const labelPeso     = document.getElementById('label-peso')!;
  const labelAltura   = document.getElementById('label-altura')!;
  const btnMale       = document.getElementById('btn-gender-male') as HTMLButtonElement;
  const btnFemale     = document.getElementById('btn-gender-female') as HTMLButtonElement;
  const inpEdad       = document.getElementById('cal-edad') as HTMLInputElement;
  const inpPeso       = document.getElementById('cal-peso') as HTMLInputElement;
  const inpAltura     = document.getElementById('cal-altura') as HTMLInputElement;
  const selActividad  = document.getElementById('cal-actividad') as HTMLSelectElement;
  const selObjetivo   = document.getElementById('cal-objetivo') as HTMLSelectElement;
  const selMacro      = document.getElementById('cal-macro-preset') as HTMLSelectElement;
  const btnCalcular   = document.getElementById('btn-calcular-cal') as HTMLButtonElement;
  const btnExportCsv  = document.getElementById('btn-export-cal-csv') as HTMLButtonElement;
  const btnImprimir   = document.getElementById('btn-imprimir-cal') as HTMLButtonElement;

  const customWrap    = document.getElementById('custom-macros-wrap') as HTMLElement;
  const rangeP        = document.getElementById('range-p') as HTMLInputElement;
  const rangeC        = document.getElementById('range-c') as HTMLInputElement;
  const rangeF        = document.getElementById('range-f') as HTMLInputElement;
  const valCustomP    = document.getElementById('val-custom-p')!;
  const valCustomC    = document.getElementById('val-custom-c')!;
  const valCustomF    = document.getElementById('val-custom-f')!;
  const customSumText = document.getElementById('custom-sum-text')!;

  // Salidas UI
  const statCalTarget = document.getElementById('stat-cal-target')!;
  const statCalSub    = document.getElementById('stat-cal-sub')!;
  const statTmb       = document.getElementById('stat-tmb')!;
  const statTdee      = document.getElementById('stat-tdee')!;
  const statAgua      = document.getElementById('stat-agua')!;
  const badgeMacro    = document.getElementById('badge-macro-name')!;

  const barP          = document.getElementById('bar-p') as HTMLElement;
  const barC          = document.getElementById('bar-c') as HTMLElement;
  const barF          = document.getElementById('bar-f') as HTMLElement;

  const statMacroPG   = document.getElementById('stat-macro-p-g')!;
  const statMacroPCal = document.getElementById('stat-macro-p-cal')!;
  const statMacroPPct = document.getElementById('stat-macro-p-pct')!;
  const statMacroPKg  = document.getElementById('stat-macro-p-perkg')!;

  const statMacroCG   = document.getElementById('stat-macro-c-g')!;
  const statMacroCCal = document.getElementById('stat-macro-c-cal')!;
  const statMacroCPct = document.getElementById('stat-macro-c-pct')!;
  const statMacroCKg  = document.getElementById('stat-macro-c-perkg')!;

  const statMacroFG   = document.getElementById('stat-macro-f-g')!;
  const statMacroFCal = document.getElementById('stat-macro-f-cal')!;
  const statMacroFPct = document.getElementById('stat-macro-f-pct')!;
  const statMacroFKg  = document.getElementById('stat-macro-f-perkg')!;

  const statProyRitmo = document.getElementById('stat-proyeccion-ritmo')!;
  const statProyMes   = document.getElementById('stat-proyeccion-mes')!;
  const tablaComidasBody = document.getElementById('tabla-comidas-body')!;

  // Salidas Impresión
  const printFecha   = document.getElementById('print-cal-fecha')!;
  const printPerfil  = document.getElementById('print-cal-perfil')!;
  const printAntropo = document.getElementById('print-cal-antropo')!;
  const printMeta    = document.getElementById('print-cal-meta')!;
  const printTmb     = document.getElementById('print-cal-tmb')!;
  const printTdee    = document.getElementById('print-cal-tdee')!;
  const printMacPG   = document.getElementById('print-mac-p-g')!;
  const printMacPCal = document.getElementById('print-mac-p-cal')!;
  const printMacPPct = document.getElementById('print-mac-p-pct')!;
  const printMacCG   = document.getElementById('print-mac-c-g')!;
  const printMacCCal = document.getElementById('print-mac-c-cal')!;
  const printMacCPct = document.getElementById('print-mac-c-pct')!;
  const printMacFG   = document.getElementById('print-mac-f-g')!;
  const printMacFCal = document.getElementById('print-mac-f-cal')!;
  const printMacFPct = document.getElementById('print-mac-f-pct')!;
  const printMacTot  = document.getElementById('print-mac-total-cal')!;

  // Selector de comidas
  const mealButtons = document.querySelectorAll('.toggle-btn[data-comidas]');
  mealButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      mealButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      numComidas = parseInt(btn.getAttribute('data-comidas') || '4');
      calcularTodo();
    });
  });

  // Toggle Unidades
  btnMetric.addEventListener('click', () => {
    if (isMetric) return;
    isMetric = true;
    btnMetric.classList.add('active');
    btnImperial.classList.remove('active');
    labelPeso.textContent = 'Peso (kg)';
    labelAltura.textContent = 'Estatura (cm)';

    // Convertir lb -> kg y in -> cm
    const pesoLb = parseFloat(inpPeso.value) || 165;
    const alturaIn = parseFloat(inpAltura.value) || 69;
    inpPeso.value = (pesoLb * 0.453592).toFixed(1);
    inpAltura.value = String(round(alturaIn * 2.54));
    calcularTodo();
  });

  btnImperial.addEventListener('click', () => {
    if (!isMetric) return;
    isMetric = false;
    btnImperial.classList.add('active');
    btnMetric.classList.remove('active');
    labelPeso.textContent = 'Peso (libras - lb)';
    labelAltura.textContent = 'Estatura (pulgadas - in)';

    // Convertir kg -> lb y cm -> in
    const pesoKg = parseFloat(inpPeso.value) || 75;
    const alturaCm = parseFloat(inpAltura.value) || 175;
    inpPeso.value = (pesoKg * 2.20462).toFixed(1);
    inpAltura.value = (alturaCm / 2.54).toFixed(1);
    calcularTodo();
  });

  // Toggle Género
  btnMale.addEventListener('click', () => {
    gender = 'male';
    btnMale.classList.add('active');
    btnMale.setAttribute('aria-checked', 'true');
    btnFemale.classList.remove('active');
    btnFemale.setAttribute('aria-checked', 'false');
    calcularTodo();
  });

  btnFemale.addEventListener('click', () => {
    gender = 'female';
    btnFemale.classList.add('active');
    btnFemale.setAttribute('aria-checked', 'true');
    btnMale.classList.remove('active');
    btnMale.setAttribute('aria-checked', 'false');
    calcularTodo();
  });

  // Selector de Presets de Macros
  selMacro.addEventListener('change', () => {
    const isCustom = selMacro.value === 'custom';
    customWrap.style.display = isCustom ? 'flex' : 'none';
    if (!isCustom) {
      const [p, c, f] = MACRO_PRESETS[selMacro.value];
      rangeP.value = String(p);
      rangeC.value = String(c);
      rangeF.value = String(f);
      valCustomP.textContent = `${p}%`;
      valCustomC.textContent = `${c}%`;
      valCustomF.textContent = `${f}%`;
    }
    calcularTodo();
  });

  // Sliders Custom
  [rangeP, rangeC, rangeF].forEach(r => {
    r.addEventListener('input', () => {
      valCustomP.textContent = `${rangeP.value}%`;
      valCustomC.textContent = `${rangeC.value}%`;
      valCustomF.textContent = `${rangeF.value}%`;
      const sum = parseInt(rangeP.value) + parseInt(rangeC.value) + parseInt(rangeF.value);
      customSumText.textContent = `${sum}%`;
      customSumText.style.color = sum === 100 ? 'var(--accent)' : '#f87171';
      calcularTodo();
    });
  });

  interface CalculoResultado {
    pesoKg: number;
    alturaCm: number;
    edad: number;
    gender: string;
    tmb: number;
    tdee: number;
    calTarget: number;
    deltaKcal: number;
    aguaLitros: number;
    pctP: number;
    pctC: number;
    pctF: number;
    gP: number;
    gC: number;
    gF: number;
    calP: number;
    calC: number;
    calF: number;
    ritmoSemanalKg: number;
    ritmoMensualKg: number;
    metaTexto: string;
  }

  let ultimoCalculo: CalculoResultado | null = null;

  function calcularTodo(): CalculoResultado {
    // 1. Obtener valores normalizados a métrico
    let pesoKg = parseFloat(inpPeso.value) || 70;
    let alturaCm = parseFloat(inpAltura.value) || 170;
    const edad = parseInt(inpEdad.value) || 25;

    if (!isMetric) {
      pesoKg = pesoKg * 0.453592;
      alturaCm = alturaCm * 2.54;
    }

    // 2. Tasa Metabólica Basal (Mifflin-St Jeor)
    let tmb = (10 * pesoKg) + (6.25 * alturaCm) - (5 * edad);
    tmb += (gender === 'male' ? 5 : -161);
    tmb = round(tmb);

    // 3. Gasto Energético Total Diario (TDEE)
    const factorActividad = parseFloat(selActividad.value) || 1.375;
    const tdee = round(tmb * factorActividad);

    // 4. Calorías Objetivo
    const factorObjetivo = parseFloat(selObjetivo.value) || 0;
    let calTarget = round(tdee * (1 + factorObjetivo));
    // No permitir menos de 1000 kcal para evitar inanición
    calTarget = Math.max(calTarget, 1000);
    const deltaKcal = calTarget - tdee;

    // 5. Agua diaria recomendada: 35 ml/kg + extra según actividad
    const aguaLitros = round1((pesoKg * 0.035) + ((factorActividad - 1.2) * 1.5));

    // 6. Macronutrientes
    let pctP = 30;
    let pctC = 40;
    let pctF = 30;

    if (selMacro.value === 'custom') {
      pctP = parseInt(rangeP.value);
      pctC = parseInt(rangeC.value);
      pctF = parseInt(rangeF.value);
      const totalPct = pctP + pctC + pctF;
      // Normalizar a 100 si no suma 100
      if (totalPct > 0 && totalPct !== 100) {
        pctP = round((pctP / totalPct) * 100);
        pctC = round((pctC / totalPct) * 100);
        pctF = 100 - pctP - pctC;
      }
    } else {
      [pctP, pctC, pctF] = MACRO_PRESETS[selMacro.value] || [30, 40, 30];
    }

    const calP = round(calTarget * (pctP / 100));
    const calC = round(calTarget * (pctC / 100));
    const calF = round(calTarget * (pctF / 100));

    const gP = round(calP / 4);
    const gC = round(calC / 4);
    const gF = round(calF / 9);

    const perKgP = round1(gP / pesoKg);
    const perKgC = round1(gC / pesoKg);
    const perKgF = round1(gF / pesoKg);

    // 7. Proyección de ritmo (1 kg grasa ≈ 7700 kcal)
    const ritmoSemanalKg = round1((deltaKcal * 7) / 7700);
    const ritmoMensualKg = round1(ritmoSemanalKg * 4.3);

    // 8. Renderizar UI Principal
    statCalTarget.textContent = `${fmtNum(calTarget)} kcal`;
    statTmb.textContent = fmtNum(tmb);
    statTdee.textContent = fmtNum(tdee);
    statAgua.textContent = `${aguaLitros} L`;

    const metaTexto = selObjetivo.options[selObjetivo.selectedIndex].text;
    if (deltaKcal < 0) {
      statCalSub.textContent = `Déficit de ${fmtNum(Math.abs(deltaKcal))} kcal respecto a tu gasto diario (${fmtNum(tdee)} kcal)`;
    } else if (deltaKcal > 0) {
      statCalSub.textContent = `Superávit de +${fmtNum(deltaKcal)} kcal sobre tu gasto diario para ganar masa muscular`;
    } else {
      statCalSub.textContent = `Mantenimiento exacto: consumes lo mismo que gastas (${fmtNum(tdee)} kcal)`;
    }

    badgeMacro.textContent = selMacro.options[selMacro.selectedIndex].text.split('(')[0].trim();

    // Actualizar barras
    barP.style.width = `${pctP}%`;
    barC.style.width = `${pctC}%`;
    barF.style.width = `${pctF}%`;

    // Actualizar valores de macros
    statMacroPG.textContent = `${gP} g`;
    statMacroPCal.textContent = fmtNum(calP);
    statMacroPPct.textContent = `${pctP}%`;
    statMacroPKg.textContent = `${perKgP} g/kg`;

    statMacroCG.textContent = `${gC} g`;
    statMacroCCal.textContent = fmtNum(calC);
    statMacroCPct.textContent = `${pctC}%`;
    statMacroCKg.textContent = `${perKgC} g/kg`;

    statMacroFG.textContent = `${gF} g`;
    statMacroFCal.textContent = fmtNum(calF);
    statMacroFPct.textContent = `${pctF}%`;
    statMacroFKg.textContent = `${perKgF} g/kg`;

    // Actualizar Proyección
    if (deltaKcal < 0) {
      statProyRitmo.textContent = `~${Math.abs(ritmoSemanalKg)} kg de grasa por semana`;
      statProyMes.textContent = `${ritmoMensualKg} kg/mes`;
      statProyMes.style.color = 'var(--accent)';
    } else if (deltaKcal > 0) {
      statProyRitmo.textContent = `~+${ritmoSemanalKg} kg de peso por semana`;
      statProyMes.textContent = `+${ritmoMensualKg} kg/mes`;
      statProyMes.style.color = '#38bdf8';
    } else {
      statProyRitmo.textContent = 'Peso estable (Recomposición o Mantenimiento)';
      statProyMes.textContent = '0.0 kg/mes';
      statProyMes.style.color = 'var(--text-muted)';
    }

    // 9. Tabla de Reparto por Comidas
    let htmlComidas = '';
    const mealDistribution: Record<number, { name: string; pct: number }[]> = {
      3: [
        { name: '🍳 Desayuno', pct: 0.35 },
        { name: '🥗 Almuerzo', pct: 0.40 },
        { name: '🍲 Cena',     pct: 0.25 },
      ],
      4: [
        { name: '🍳 Desayuno', pct: 0.25 },
        { name: '🥗 Almuerzo', pct: 0.35 },
        { name: '🍎 Merienda / Pre-entreno', pct: 0.15 },
        { name: '🍲 Cena',     pct: 0.25 },
      ],
      5: [
        { name: '🍳 Desayuno', pct: 0.25 },
        { name: '🥪 Media Mañana', pct: 0.10 },
        { name: '🥗 Almuerzo', pct: 0.35 },
        { name: '🍎 Merienda', pct: 0.10 },
        { name: '🍲 Cena',     pct: 0.20 },
      ]
    };

    const meals = mealDistribution[numComidas] || mealDistribution[4];
    meals.forEach(m => {
      const mCal = round(calTarget * m.pct);
      const mP = round(gP * m.pct);
      const mC = round(gC * m.pct);
      const mF = round(gF * m.pct);
      htmlComidas += `
        <tr>
          <td style="text-align:left; font-weight:700;">${m.name}</td>
          <td>${round(m.pct * 100)}%</td>
          <td style="font-weight:700; color:var(--accent);">${fmtNum(mCal)} kcal</td>
          <td style="color:#38bdf8;">${mP} g</td>
          <td style="color:#fbbf24;">${mC} g</td>
          <td style="color:#f87171;">${mF} g</td>
        </tr>
      `;
    });
    tablaComidasBody.innerHTML = htmlComidas;

    // 10. Actualizar Ficha de Impresión
    const fechaStr = new Date().toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' });
    printFecha.textContent = fechaStr;
    printPerfil.textContent = `${gender === 'male' ? 'Hombre' : 'Mujer'}, ${edad} años`;
    printAntropo.textContent = `${round1(pesoKg)} kg · ${round(alturaCm)} cm`;
    printMeta.textContent = metaTexto;
    printTmb.textContent = `${fmtNum(tmb)} kcal`;
    printTdee.textContent = `${fmtNum(tdee)} kcal`;
    printMacPG.textContent = `${gP} g`;
    printMacPCal.textContent = `${fmtNum(calP)} kcal`;
    printMacPPct.textContent = `${pctP}%`;
    printMacCG.textContent = `${gC} g`;
    printMacCCal.textContent = `${fmtNum(calC)} kcal`;
    printMacCPct.textContent = `${pctC}%`;
    printMacFG.textContent = `${gF} g`;
    printMacFCal.textContent = `${fmtNum(calF)} kcal`;
    printMacFPct.textContent = `${pctF}%`;
    printMacTot.textContent = `${fmtNum(calTarget)} kcal/día`;

    ultimoCalculo = {
      pesoKg,
      alturaCm,
      edad,
      gender,
      tmb,
      tdee,
      calTarget,
      deltaKcal,
      aguaLitros,
      pctP,
      pctC,
      pctF,
      gP,
      gC,
      gF,
      calP,
      calC,
      calF,
      ritmoSemanalKg,
      ritmoMensualKg,
      metaTexto
    };

    return ultimoCalculo;
  }

  // Event Listeners
  btnCalcular.addEventListener('click', calcularTodo);
  [inpEdad, inpPeso, inpAltura, selActividad, selObjetivo].forEach(el => {
    el.addEventListener('input', calcularTodo);
    el.addEventListener('change', calcularTodo);
  });

  // Exportar a CSV
  btnExportCsv.addEventListener('click', () => {
    const res = calcularTodo();
    const csvContent = [
      ['Parametro', 'Valor', 'Detalle'],
      ['Fecha de calculo', new Date().toISOString().slice(0, 10), ''],
      ['Perfil', `${res.gender === 'male' ? 'Hombre' : 'Mujer'}, ${res.edad} anios`, ''],
      ['Peso', `${res.pesoKg.toFixed(1)} kg`, ''],
      ['Estatura', `${res.alturaCm.toFixed(1)} cm`, ''],
      ['Metabolismo Basal (TMB)', `${res.tmb} kcal`, 'Mifflin-St Jeor'],
      ['Gasto Diario Total (TDEE)', `${res.tdee} kcal`, 'Mantenimiento'],
      ['Objetivo', res.metaTexto, ''],
      ['Calorias Diarias Meta', `${res.calTarget} kcal`, `${res.deltaKcal >= 0 ? '+' : ''}${res.deltaKcal} kcal`],
      ['Agua recomendada', `${res.aguaLitros} L`, 'Diario'],
      ['Proteinas', `${res.gP} g (${res.calP} kcal)`, `${res.pctP}% total`],
      ['Carbohidratos', `${res.gC} g (${res.calC} kcal)`, `${res.pctC}% total`],
      ['Grasas', `${res.gF} g (${res.calF} kcal)`, `${res.pctF}% total`],
      ['Ritmo estimado semanal', `${res.ritmoSemanalKg} kg/semana`, 'Estimacion teorica'],
      ['Ritmo estimado mensual', `${res.ritmoMensualKg} kg/mes`, 'Estimacion teorica']
    ].map(e => e.map(c => `"${c}"`).join(',')).join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `plan-calorias-macros-${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Imprimir Ficha
  btnImprimir.addEventListener('click', () => {
    calcularTodo();
    window.print();
  });

  // Ejecución inicial
  calcularTodo();
</script>
