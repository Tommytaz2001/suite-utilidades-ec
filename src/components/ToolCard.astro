---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  badge?: string;
}
const { title, description, icon, href, badge } = Astro.props;
---
<a href={href} style="text-decoration:none;" class="tool-card-link">
  <article class="card tool-card" style="height:100%; transition: all 0.25s; position:relative; overflow:hidden;">
    <div style="font-size:2rem; margin-bottom:0.75rem;">{icon}</div>
    {badge && <span class="badge badge-green" style="position:absolute;top:1rem;right:1rem;font-size:0.7rem;">{badge}</span>}
    <h3 style="font-size:1rem; font-weight:700; margin-bottom:0.5rem; color:var(--text);">{title}</h3>
    <p style="color:var(--text-muted); font-size:0.875rem; line-height:1.6; margin:0;">{description}</p>
    <div style="margin-top:1rem; display:flex; align-items:center; gap:0.375rem; color:var(--accent); font-size:0.8125rem; font-weight:600;">
      Abrir herramienta
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </article>
</a>

<style>
  .tool-card-link:hover .tool-card {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(16,185,129,0.15);
  }
</style>
