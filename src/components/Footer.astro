---
const year = new Date().getFullYear();
---
<footer style="background: var(--surface); border-top: 1px solid var(--border); margin-top: 4rem; padding: 2.5rem 1.5rem;">
  <div style="max-width: 1100px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
      <!-- Marca -->
      <div>
        <div style="font-weight: 800; font-size: 1.125rem; color: var(--accent); margin-bottom: 0.75rem;">⚡ Herramientas EC</div>
        <p style="color: var(--text-muted); font-size: 0.875rem; line-height: 1.6;">
          Suite gratuita de herramientas financieras, laborales y técnicas para Ecuador y Latinoamérica.
        </p>
      </div>

      <!-- Herramientas -->
      <div>
        <div style="font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Herramientas</div>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <li><a href="/simulador-credito-ecuador/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Simulador de Crédito Ecuador</a></li>
          <li><a href="/calculadora-laboral-ecuador/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Calculadora Laboral Ecuador</a></li>
          <li><a href="/calculadora-deficit-calorico/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Calculadora de Calorías y Macros</a></li>
          <li><a href="/compresor-imagenes/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Compresor de Imágenes</a></li>
          <li><a href="/formateador-json-limpiador-listas/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Formateador JSON</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <div style="font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.75rem;">Legal</div>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <li><a href="/politica-de-privacidad/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Política de Privacidad</a></li>
          <li><a href="/terminos-de-servicio/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Términos de Servicio</a></li>
          <li><a href="/contacto/" style="color:var(--text-muted); text-decoration:none; font-size:0.875rem;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Contacto</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div style="border-top: 1px solid var(--border); padding-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;">
      <p style="color: var(--text-muted); font-size: 0.8125rem; margin: 0;">
        © {year} Herramientas EC — Todas las herramientas procesan datos localmente en tu navegador.
      </p>
      <p style="color: var(--text-muted); font-size: 0.75rem; margin: 0;">
        Los resultados son referenciales. Consulta a un profesional.
      </p>
    </div>
  </div>
</footer>
